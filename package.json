{
  "workspaces": [
    "config",
    "docs",
    "lib",
    "example"
  ],
  "packageManager": "yarn@4.5.3",
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "@changesets/cli": "^2.31.1",
    "turbo": "^2.10.8"
  },
  "devDependencies": {
    "@timhettler/config": "workspace:*",
    "prettier": "^3.9.6"
  },
  "scripts": {
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "build": "turbo build",
    "test": "turbo test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "release": "turbo run build --filter=@timhettler/radix-card && changeset publish"
  },
  "name": "radix-card",
  "resolutions": {
    "@babel/runtime": "^7.26.10",
    "@tootallnate/once": "^2.0.1",
    "brace-expansion": "^1.1.11",
    "flatted": "^3.4.0",
    "http-cache-semantics": "^4.1.1",
    "ip": "^2.0.1",
    "js-yaml": "^3.14.2",
    "minimatch": "^3.1.3",
    "picomatch": "^2.3.2",
    "tar": "^7.5.22",
    "node-gyp": "^11.0.0"
  }
}
