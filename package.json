{
  "workspaces": [
    "config",
    "docs",
    "lib",
    "example"
  ],
  "packageManager": "yarn@4.5.3",
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "@changesets/cli": "^2.31.1",
    "turbo": "^2.10.8"
  },
  "devDependencies": {
    "@timhettler/config": "workspace:*",
    "prettier": "^3.9.6"
  },
  "scripts": {
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "build": "turbo build",
    "test": "turbo test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "release": "turbo run build --filter=@timhettler/radix-card && changeset publish"
  },
  "name": "radix-card"
}
