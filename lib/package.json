{
  "name": "@timhettler/radix-card",
  "version": "1.2.1",
  "type": "module",
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "module": "./dist/radix-card.js",
  "exports": {
    ".": {
      "types": "./dist/main.d.ts",
      "default": "./dist/radix-card.js"
    }
  },
  "license": "MIT",
  "keywords": [
    "ui",
    "react",
    "accessibility",
    "radix"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/timhettler/radix-card.git"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint",
    "typecheck": "tsc",
    "format": "prettier --write .",
    "check:package": "publint && attw --pack --profile esm-only"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.2",
    "@microsoft/api-extractor": "^7.52.8",
    "@radix-ui/primitive": "^1.1.7",
    "@radix-ui/react-compose-refs": "^1.1.5",
    "@radix-ui/react-context": "^1.2.2",
    "@radix-ui/react-primitive": "^2.1.10",
    "@timhettler/config": "workspace:*",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "eslint": "^10.8.0",
    "json": "^11.0.0",
    "prettier": "^3.9.6",
    "publint": "^0.3.5",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "^5.9.3",
    "vite": "^8.2.0",
    "vite-plugin-dts": "^4.5.4"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  }
}
